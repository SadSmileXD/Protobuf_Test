<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>protobuf-net</id>
    <version>3.4.30</version>
    <title>protobuf-net</title>
    <authors>Marc Gravell</authors>
    <license type="expression">Apache-2.0</license>
    <licenseUrl>https://licenses.nuget.org/Apache-2.0</licenseUrl>
    <icon>protobuf-net.png</icon>
    <readme>readme.md</readme>
    <projectUrl>https://protobuf-net.dev/</projectUrl>
    <description>Provides simple access to fast and efficient "Protocol Buffers" serialization from .NET applications</description>
    <releaseNotes>https://github.com/protobuf-net/protobuf-net/releases</releaseNotes>
    <copyright>See https://github.com/protobuf-net/protobuf-net</copyright>
    <tags>binary serialization protobuf</tags>
    <repository type="git" url="https://github.com/protobuf-net/protobuf-net" commit="f24c4c97bb146d763425a04b6b8dd7fd89219ef3" />
    <dependencies>
      <group targetFramework=".NETFramework4.6.2">
        <dependency id="protobuf-net.Core" version="3.4.30" include="All" />
      </group>
      <group targetFramework="net8.0">
        <dependency id="protobuf-net.Core" version="3.4.30" include="All" />
      </group>
      <group targetFramework=".NETStandard2.0">
        <dependency id="protobuf-net.Core" version="3.4.30" include="All" />
        <dependency id="System.Reflection.Emit" version="4.7.0" exclude="Build,Analyzers" />
        <dependency id="System.Reflection.Emit.Lightweight" version="4.7.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.1">
        <dependency id="protobuf-net.Core" version="3.4.30" include="All" />
      </group>
    </dependencies>
  </metadata>
</package>